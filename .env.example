POSTGRES_USER=sineva
POSTGRES_PASSWORD=
POSTGRES_DB=sineva_compro_app
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5433
DATABASE_URL=
TEST_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Default: ignore forwarded headers. See docs/runbooks/trusted-client-ip.md.
CLIENT_IP_MODE=direct
# Set true only with CLIENT_IP_MODE=cloudflare after securing every origin ingress.
CLOUDFLARE_ORIGIN_LOCKED=false
# Optional isolated HTTP test origin (default http://127.0.0.1:3001).
# TEST_AUTH_URL=http://127.0.0.1:3068

# Public site origin for canonical URLs and social shares.
SITE_URL=http://127.0.0.1:3000
# Keep false until the public launch is approved.
SITE_INDEXABLE=false
# Phase 1 public deployments keep the custom admin disabled.
ADMIN_ENABLED=false

# Custom media admin, server-only. Use the limited app identity from CPR-67.
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# local/test for loopback; preview-<id>/production for a remote endpoint.
MEDIA_PREFIX=local
STORAGE_ENDPOINT=http://127.0.0.1:8333
# Confirm this exact origin after reviewing the storage target.
STORAGE_CONFIRM_ORIGIN=
# Optional CDN origin, without path. Unset serves published assets through the app.
MEDIA_PUBLIC_ORIGIN=

# Public content source: static (default, launch content in src/content/static) or database
# (content edited in the custom admin). Seed first: npm run db:migrate && npm run db:seed.
CONTENT_SOURCE=static

# Email (CPR-86). 32-byte key (base64 or 64 hex chars) that encrypts secrets saved in the admin.
SETTINGS_ENCRYPTION_KEY=
# Optional: when set, these override the admin email settings ("Managed by environment").
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Anti-spam (CPR-49). Unset outside production uses Cloudflare's always-pass test secret; production
# refuses submissions until set. The public site key goes to the form widget.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
