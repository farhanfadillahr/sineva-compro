{
  "name": "sineva-compro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:database": "vitest run --config vitest.database.config.mts",
    "setup:env": "node scripts/setup-env.mjs",
    "auth:generate": "auth generate --config src/lib/auth/config.ts --output src/features/auth/schema.ts --yes && prettier --write src/features/auth/schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "test:prepare": "tsx scripts/test-runtime.ts prepare",
    "test:server": "tsx scripts/test-runtime.ts server",
    "db:seed": "tsx scripts/seed/index.ts",
    "storage:setup": "tsx scripts/storage/cli.ts setup",
    "storage:bootstrap": "tsx scripts/storage/cli.ts bootstrap",
    "storage:check": "tsx scripts/storage/cli.ts check",
    "storage:native": "tsx scripts/storage/native.ts",
    "test:storage": "vitest run --config vitest.storage.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "better-auth": "1.7.7",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.0",
    "lottie-web": "5.13.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "auth": "1.7.7",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.1",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
