{
  "name": "sineva-compro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:database": "vitest run --config vitest.database.config.mts",
    "setup:env": "node scripts/setup-env.mjs",
    "auth:generate": "auth generate --config src/lib/auth/config.ts --output src/features/auth/schema.ts --yes && prettier --write src/features/auth/schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "test:prepare": "tsx scripts/test-runtime.ts prepare",
    "test:server": "tsx scripts/test-runtime.ts server",
    "test:http:production": "tsx scripts/test-http-production.ts"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "better-auth": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
